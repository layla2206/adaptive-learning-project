# Copy this file to .env and fill in real values. Never commit .env — only
# this template. If you're rotating the Cloudflare R2 key (it was previously
# leaked into this file directly), generate a fresh key pair after fixing
# your local .env.

# Supabase (Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2 (R2 > Manage API Tokens)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT=

# Auth — any long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=

# Gmail SMTP (https://myaccount.google.com/apppasswords) — used to send OTP +
# verification emails. GMAIL_APP_PASSWORD is a 16-character App Password,
# not your real account password — requires 2-Step Verification enabled.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google Gemini (https://aistudio.google.com/app/apikey) — used for embeddings (gemini-embedding-001) and generation (gemini-3.6-flash)
GEMINI_API_KEY="YOUR_PERSONAL_KEY_HERE"

# --- Deploy-split-only vars (Vercel frontend + Render backend as two separate services) ---
# Not needed for local dev, where both sides default to localhost.

# Set on Vercel: the deployed FastAPI backend's base URL (Render gives you
# this once the service is up, e.g. https://adaptive-tutor-backend.onrender.com).
# Every Next.js API route falls back to http://127.0.0.1:8000 if unset.
NEXT_PUBLIC_API_URL=

# Set on Render: comma-separated list of origins allowed to call the FastAPI
# backend directly from a browser (the deployed Vercel URL, once known).
# Defaults to http://localhost:3000 if unset — see main.py's CORSMiddleware
# setup. Note: the Next.js API routes proxy to this backend server-to-server,
# which isn't subject to CORS at all — this only matters for a direct
# browser-to-backend call, if one is ever added.
ALLOWED_ORIGINS= 
